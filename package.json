{
  "name": "webp-maker-local",
  "version": "1.0.2",
  "private": true,
  "description": "Local Windows and Linux MP4 to animated WebP maker using ImageMagick",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/selftest.js && node scripts/update-selftest.js",
    "package:win": "electron-packager . WebP-Maker --platform=win32 --arch=x64 --out=release --overwrite --icon=assets/icon.ico --ignore=^/release$ --ignore=^/dist$ --ignore=^/.github$ --prune=true",
    "package:linux": "electron-packager . WebP-Maker --platform=linux --arch=x64 --out=release --overwrite --icon=assets/icon.png --ignore=^/release$ --ignore=^/dist$ --ignore=^/.github$ --prune=true"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "@electron/packager": "^18.3.6"
  },
  "dependencies": {
    "7zip-bin": "5.2.0"
  }
}
